# Confidence Layer Configuration
# Copy to .env and fill in values

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://confidence:confidence@localhost:5432/confidence
DATABASE_URL_SYNC=postgresql+psycopg://confidence:confidence@localhost:5432/confidence

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Application: synthetic providers are allowed only in development/local/test.
# JWT mode can start with unavailable operator adapters; decisions fail closed.
APP_ENV=development
LOG_LEVEL=INFO
DECISION_TIMEOUT_MS=100
SAFETY_CONFIDENCE_THRESHOLD=0.5
STATE_CONFIDENCE_THRESHOLD=0.5
SAFETY_DATA_MAX_AGE_SECONDS=300.0
DEMO_MODE=true

# Server
HOST=0.0.0.0
PORT=8000

# Authentication: development uses demo-token; jwt validates identity-provider tokens.
AUTH_PROVIDER=development

# JWT mode requires DEMO_MODE=false and all three values below.
# JWKS_URL=https://identity.example/.well-known/jwks.json
# JWT_ISSUER=https://identity.example/
# JWT_AUDIENCE=confidence

# Optional inference (rules and deterministic policy are the defaults).
STATE_ESTIMATOR_TYPE=rules
STATE_ESTIMATOR_CONFIDENCE_THRESHOLD=0.5
# STATE_ESTIMATOR_MODEL_PATH=models/hesitation/v1/model.lgb
POLICY_TYPE=deterministic
BANDIT_EXPLORATION_RATE=0.1
# BANDIT_MODEL_PATH=models/policy/v1/model.vw

# Harm weight must be at least the sum of the positive weights.
SQS_W1_ACTION_VALUE=0.4
SQS_W2_DISCOVERY_EFFICIENCY=0.3
SQS_W3_HARM_INDICATOR_LOAD=0.7

RATE_LIMIT_ENABLED=true
PER_ACTOR_RPM=60
PER_IP_RPM=120
GLOBAL_RPM=10000

# off, full, percentage, or actor_list
SHADOW_MODE=off
SHADOW_PERCENTAGE=0
SHADOW_ACTORS=[]

TRACING_ENABLED=false
# OTLP_ENDPOINT=http://localhost:4317
