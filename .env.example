# Confidence Layer Configuration
# Copy to .env and fill in values

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://confidence:confidence@localhost:5432/confidence
DATABASE_URL_SYNC=postgresql+psycopg://confidence:confidence@localhost:5432/confidence

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Application
APP_ENV=development
LOG_LEVEL=INFO
DECISION_TIMEOUT_MS=100
SAFETY_CONFIDENCE_THRESHOLD=0.5
STATE_CONFIDENCE_THRESHOLD=0.5
SAFETY_DATA_MAX_AGE_SECONDS=300.0
DEMO_MODE=true

# Server
HOST=0.0.0.0
PORT=8000

# Rate Limiting
RATE_LIMIT_DECISIONS_PER_MINUTE=600
RATE_LIMIT_EVENTS_PER_MINUTE=3000

# Authentication (development: pass-through)
AUTH_PROVIDER=development

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=confidence-layer
METRICS_ENABLED=true
