# Confidence Layer Configuration
# Copy to .env and fill in values

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://confidence:confidence@localhost:5432/confidence
DATABASE_URL_SYNC=postgresql://confidence:confidence@localhost:5432/confidence

# Application
APP_ENV=development
LOG_LEVEL=INFO
DECISION_TIMEOUT_MS=100
SAFETY_CONFIDENCE_THRESHOLD=0.6
STATE_CONFIDENCE_THRESHOLD=0.5

# Server
HOST=0.0.0.0
PORT=8000
