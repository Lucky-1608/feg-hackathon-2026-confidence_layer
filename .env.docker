# Confidence Layer Configuration — Docker Container Environment
# Used by docker-compose.yml for container-to-container networking

# PostgreSQL (use service name, not localhost)
DATABASE_URL=postgresql+asyncpg://confidence:confidence@postgres:5432/confidence
DATABASE_URL_SYNC=postgresql+psycopg://confidence:confidence@postgres:5432/confidence

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# Application
APP_ENV=local
LOG_LEVEL=INFO
DECISION_TIMEOUT_MS=100
SAFETY_CONFIDENCE_THRESHOLD=0.5
STATE_CONFIDENCE_THRESHOLD=0.5
DEMO_MODE=true

# Server
HOST=0.0.0.0
PORT=8000
